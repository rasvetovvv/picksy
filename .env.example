# ──────────────────────────────────────────────────────────────
# Picksy / PickForMe — environment variables
# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# Never commit .env — it is git-ignored.
# ──────────────────────────────────────────────────────────────

# ─── Site ─────────────────────────────────────────────────────
# Domain used in share links and OG meta. Use localhost for dev.
SITE_HOST=localhost:7888

# ─── TMDB (Movies + TV) ───────────────────────────────────────
# Required for movies/TV. Free: https://www.themoviedb.org/settings/api
# Use the v4 "API Read Access Token" (JWT) or v3 API key.
TMDB_API_KEY=

# ─── Google Books ─────────────────────────────────────────────
# Optional. API works without a key but with a lower quota.
# https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=

# ─── Google Sign-In (OAuth) ───────────────────────────────────
# Optional. Only needed if you want Google login on the frontend.
# https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=

# ─── AI search ────────────────────────────────────────────────
# Default: Groq (fast, free tier). Any OpenAI-compatible provider works.
# Get a Groq key: https://console.groq.com/keys
AI_PROVIDER=groq
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant

# Alternative — OpenAI (paid). Uncomment and set AI_PROVIDER=openai.
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Alternative — OpenRouter (many free models). Uncomment and set AI_PROVIDER=openrouter.
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_REFERER=https://your-domain.example
# OPENROUTER_TITLE=Picksy

# ─── Telegram bot (optional) ──────────────────────────────────
# Only needed if you also want to run the bundled Telegram bot.
# Create a bot: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs that get admin commands.
PICKSY_BOT_ADMIN_IDS=
# Chat where the bot posts admin notifications (negative for groups).
PICKSY_ADMIN_CHAT_ID=

# ─── MySQL ────────────────────────────────────────────────────
# docker-compose spins up MySQL with these creds. Change the
# passwords before deploying to anything public.
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=pickforme
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=pickforme
MYSQL_ROOT_PASSWORD=change-me-too
