    "tv show picker",
    "book recommendation",
    "what to watch",
    "mood based movie picker",
    "ukrainian ai",
    "vadym mosoruk"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "minify": "mkdir -p dist/js dist/css && npx esbuild css/style.css --minify --outfile=dist/css/style.min.css && for f in js/*.js; do npx esbuild \"$f\" --minify --outfile=\"dist/$f\"; done",
    "prod": "npm run build && npm run minify"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3"
  }
}
